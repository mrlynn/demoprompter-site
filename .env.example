# Optional public overrides. If either URL is set, the Download button
# uses it instead of the GitHub Releases API.
# Useful when the app repo is private or the DMG is hosted elsewhere.
NEXT_PUBLIC_DMG_URL=
NEXT_PUBLIC_RELEASE_VERSION=

# Canonical site URL for Open Graph and sitemap. Set this on Vercel.
NEXT_PUBLIC_SITE_URL=https://demoprompter.app
